# LinkHub Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=linkhub_production_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# MySQL Database Configuration (Local or Cloud)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=linkhub_db

# Or use unified connection string for Railway / Render:
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:7392/railway

# Google OAuth Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Client URLs (for CORS)
FRONTEND_URL=http://localhost:8081
NETLIFY_URL=https://linkhub-social.netlify.app
